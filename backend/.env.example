# Server & Database
NODE_ENV=development
PORT=8080
MONGO_URI=mongodb://localhost:27017/wedding-invitations

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth (Tuỳ chọn)
GOOGLE_CLIENT_ID=

# Email SMTP (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary (Lưu trữ ảnh & media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

