              <span
                className={`hidden sm:inline-block px-2.5 py-1 rounded-full text-[10px] font-semibold border ${
                  isOwned
                    ? "bg-emerald-950/20 text-emerald-400 border-emerald-800/45"
                    : "bg-amber-950/20 text-amber-400 border-amber-800/45"
                }`}
              ></span>
            );
