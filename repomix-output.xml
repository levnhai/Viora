@custom-variant dark (&:is(.dark *));

.theme-pink {
  --background: #fdf6ef;
  --foreground: #2c1810;
  --card: #fff9f4;
  --card-foreground: #2c1810;
  --popover: #fff9f4;
  --popover-foreground: #2c1810;
  --primary: #8b3a52;
  --primary-foreground: #fdf6ef;
  --secondary: #f5e8dc;
  --secondary-foreground: #2c1810;
  --muted: #ede2d8;
  --muted-foreground: #7a5c4f;
  --accent: #c9956c;
