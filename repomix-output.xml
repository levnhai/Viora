          </div>
          <h1 style={{ fontFamily: "'Great Vibes', cursive", fontSize: "clamp(3rem, 10vw, 5rem)", color: "var(--primary)", lineHeight: 1.1 }}>
            {brideName}
          </h1>
        </div>
        <p className="text-sm text-muted-foreground" style={{ letterSpacing: "0.15em" }}>{formatDate(weddingDate)}</p>
        <p className="text-sm leading-relaxed text-muted-foreground">
          {guestName 
            ? `Rất vinh hạnh được đón tiếp ${guestName} đến chung vui cùng chúng tôi!` 
